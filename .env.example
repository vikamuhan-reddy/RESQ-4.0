# RESQ 4.0 Environment Configuration
# Copy this to .env and fill in your values

# Google Gemini API Key (get from https://aistudio.google.com)
# If not set, falls back to keyword-based parsing (demo mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Geocoding confidence threshold (0.0-1.0, default 0.4)
GEOCODE_CONFIDENCE_THRESHOLD=0.4

# Dispatch mode: "simulation" (default, safe for demos) or "live" (real dispatch)
DISPATCH_MODE=simulation

# CORS allowed origins (comma-separated) - defaults to localhost only
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# RESQ 4.0 Environment Configuration
# Copy this to .env and fill in your values

# Google Gemini API Key (get from https://aistudio.google.com)
# If not set, falls back to keyword-based parsing (demo mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Map search area for "Find on map" (lon_min,lat_max,lon_max,lat_min) - Chennai by default
GEOCODE_VIEWBOX=80.05,13.30,80.35,12.80

# Dispatch mode: "simulation" (default, safe for demos) or "live" (real dispatch)
DISPATCH_MODE=simulation

# Optional: Gemini models tried in order (defaults shown)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Telegram delivery of approved dispatches (demo stand-in for department systems).
# Without TELEGRAM_BOT_TOKEN, approvals are marked as a simulated delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_AMBULANCE=
TELEGRAM_CHAT_FIRE=
TELEGRAM_CHAT_POLICE=

# CORS allowed origins (comma-separated) - defaults to localhost only
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
